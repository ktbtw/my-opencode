      "type": "local",
      "title": "YaraFlux MCP Server",
      "config": {
        "name": "yaraflux-mcp-server",
        "type": "local",
        "command": [
          "docker",
          "run",
          "-i",
          "--rm",
          "-v",
          "${MCP_HOME}/rules:/rules",
          "-v",
          "${MCP_HOME}/samples:/samples",
          "--env",
          "DEBUG=false",
          "--env",
          "PYTHONUNBUFFERED=1",
          "threatflux/yaraflux-mcp-server:latest"
        ],
        "enabled": true,
        "timeout": 30000,
        "environment": {
          "YARAFLUX_RULES_DIR": "${MCP_HOME}/rules",
          "YARAFLUX_SAMPLES_DIR": "${MCP_HOME}/samples"
        }
      },
      "source": "ThreatFlux/YaraFlux",
      "enabled": true,
      "install": {
        "source_url": "https://github.com/ThreatFlux/YaraFlux",
