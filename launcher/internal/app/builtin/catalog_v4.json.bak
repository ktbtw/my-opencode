          "content": "interface:\n  display_name: \"Verify Framework\"\n  short_description: \"Verify 心跳、云代码、Patch、崩溃与设备调试指南\"\n  default_prompt: \"Use $verify-framework to integrate heartbeat verification, build, publish, patch, query crash reports, and debug a Verify Android runtime.\"\n"
