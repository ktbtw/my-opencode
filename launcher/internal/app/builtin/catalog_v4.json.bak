          "-v",
          "${MCP_HOME}/rules:/rules",
          "${MCP_HOME}/samples:/samples",
          "--env",
          "DEBUG=false",
          "PYTHONUNBUFFERED=1",
          "threatflux/yaraflux-mcp-server:latest"
        ]
      },
